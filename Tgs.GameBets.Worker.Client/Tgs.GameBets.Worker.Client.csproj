<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<Version>1.0.7</Version>
		<Authors>Raypro</Authors>
		<PackageProjectUrl>https://gitlab.com/rayprosoft/tgs-gamebets-worker</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/rayprosoft/tgs-gamebets-worker.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RootNamespace>Tgs.GameBets.Worker.Client</RootNamespace>
		<PackageId>Tgs.GameBets.Worker.Client</PackageId>
		<Title>Tgs.GameBets.Worker.Client</Title>
		<Description>Tgs.GameBets.Worker.Client</Description>
		<PackageTags>Tgs GameBets Worker Client</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.65.0" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
		<PackageReference Include="PhoenixToolkits.NuGet.BuildTools" Version="0.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="PhoenixToolkits.Protobuf.ExtendTypes" Version="0.0.7" />
		<PackageReference Include="System.Interactive.Async" Version="6.0.1" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\Tgs.GameBets.Worker.Common\Tgs.GameBets.Worker.Common.csproj">
		  <PrivateAssets>all</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

</Project>
